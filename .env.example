# Google Gemini (resumo, tier gratuito) — chave em aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Telegram Bot API (envio do resumo). TELEGRAM_CHAT_ID só serve para semear o
# primeiro destinatário em data/recipients.json — depois disso os destinatários
# passam a ser descobertos automaticamente (ver notifier/recipients.py)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telethon (leitura do canal público do Fabrizio Romano) — necessário quando ligarmos essa fonte
TELETHON_API_ID=
TELETHON_API_HASH=
TELETHON_SESSION_NAME=newsai_session
TELETHON_CHANNEL_USERNAME=fabrizioromanotg
# Só necessário em CI (GitHub Actions) — gerado por telethon_session_to_string.py
TELETHON_STRING_SESSION=
